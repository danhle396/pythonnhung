# Sao chép thành .env và điền giá trị thật. KHÔNG commit .env.
DATABASE_URL=sqlite:///backend/aiot.db
# Docker: DATABASE_URL=postgresql+psycopg://aiot:aiot-pass@db:5432/aiot

MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=backend
MQTT_PASS=backend-pass
MQTT_ENABLED=true

JWT_SECRET=change-me-in-production
ADMIN_USER=admin
ADMIN_PASS=admin123

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
DASHBOARD_URL=http://localhost:8501

STATION_LAT=15.975
STATION_LON=108.253
STATION_ALT_M=8.0
STATION_TZ=Asia/Ho_Chi_Minh
DEFAULT_DEVICE_ID=station01
FORECAST_EVERY_MIN=10
USE_OPEN_METEO_FALLBACK=true
