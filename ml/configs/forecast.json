  "gbdt_clf": {"n_estimators": 1000, "learning_rate": 0.05, "max_depth": 5, "min_samples_leaf": 40,
               "reg_lambda": 1.0, "subsample": 0.8, "colsample": 0.8, "max_bins": 64, "early_stopping_rounds": 40},
  "logistic": {"alpha": 1e-4, "lr": 0.01, "epochs": 60, "batch_size": 512},
  "gru": {"enabled": true, "window": 24, "hidden": 32, "epochs": 25, "lr": 0.003, "batch_size": 256}
}
